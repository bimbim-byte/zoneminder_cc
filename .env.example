# ==============================================================================
# ZoneMinder CCTV Management - Environment Template
#
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#     cp .env.example .env
#
# File .env TIDAK ikut ter-commit (lihat .gitignore bagian 3).
# Jangan pernah menaruh password asli di file ini.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KREDENSIAL ZONEMINDER (WAJIB)
# ------------------------------------------------------------------------------
# Akun ini dipakai oleh: dashboard (app.py), CCTV health checker (main.py),
# dan halaman zoneminder.html (lewat /api/config, bukan hardcode lagi).
#
# Ganti default setelah instalasi pertama:
#   ZoneMinder > Options > Users > pilih user > ubah password
# Lalu perbarui nilai di bawah dan jalankan: docker compose up -d
ZM_USER=admin
ZM_PASS=P@ssw0rd

# Alamat ZoneMinder untuk skrip yang jalan dari HOST (scripts/zm_automate.py).
# Dari dalam container nilainya berbeda — lihat ZM_HOST di docker-compose.yml.
ZM_HOST=https://localhost/zm

# ------------------------------------------------------------------------------
# 1b. DATABASE ZONEMINDER (OPSIONAL — hanya untuk scripts/test_db.py)
# ------------------------------------------------------------------------------
# Skrip diagnostik database TIDAK ikut container; dijalankan manual dari host.
# Bila blok ini dibiarkan kosong, nilainya jatuh ke ZM_USER/ZM_PASS di atas.
# Kosongkan/hapus bila tidak memakai skrip diagnostik.
#
# Perhatian: user MySQL ZoneMinder (default 'zmuser') berbeda dari user web
# ZoneMinder. Lihat zm-conf/ atau Options > Database untuk nilainya.
ZM_DB_HOST=localhost
ZM_DB_PORT=3306
ZM_DB_NAME=zm
# ZM_DB_USER=zmuser
# ZM_DB_PASS=ganti_dengan_password_mysql

# ------------------------------------------------------------------------------
# 2. INTERVAL & PERILAKU CCTV HEALTH CHECKER
# ------------------------------------------------------------------------------
# Interval pengecekan RTSP (detik). 600 = 10 menit, cukup untuk pemantauan.
CHECK_INTERVAL=600

# Timeout koneksi TCP ke port RTSP kamera (detik).
RTSP_TIMEOUT=3.0

# Umur simpan log MQTT sebelum dibersihkan otomatis (hari).
RETENTION_DAYS=10

# Status checker saat container pertama dinyalakan: true = langsung aktif.
# false = menunggu tombol "Aktifkan Checker" di dashboard.
CHECKER_ENABLED=false

# ------------------------------------------------------------------------------
# 3. MQTT
# ------------------------------------------------------------------------------
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC=cctv/#

# ------------------------------------------------------------------------------
# 4. DASHBOARD
# ------------------------------------------------------------------------------
# Jumlah thread waitress. Satu thread per koneksi MJPEG persisten.
# 64 cukup untuk wall dashboard (maks 16 stream bersamaan) + pengguna web.
WSGI_THREADS=64

# ------------------------------------------------------------------------------
# 5. PORT (ubah bila bentrok dengan layanan lain di host)
# ------------------------------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
DASHBOARD_PORT=8080
ZONEMINDER_PORT=8082
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001
