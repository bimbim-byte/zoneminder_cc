# ==============================================================================
# ZoneMinder CCTV Management - Environment Template
#
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#     Windows : copy .env.example .env
#     Linux   : cp .env.example .env
#
# Setelah disalin, WAJIB diisi minimal 2 hal:
#   1. DASH_SECRET_KEY  (bagian 4) -> buat 32 byte acak, JANGAN pakai nilai contoh
#   2. MQTT_USER + MQTT_PASS (bagian 3) -> harus SAMA dengan isi
#      mosquitto_config/passwd, kalau tidak cctv-checker ditolak broker
#
# Semua nilai lain di file ini sudah berupa DEFAULT AMAN untuk instalasi baru.
# Tanpa mengisi dua hal di atas, docker compose up -d akan berhenti dengan
# pesan: required variable ... is missing a value.
#
# File .env TIDAK ikut ter-commit (lihat .gitignore bagian 3).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KREDENSIAL ZONEMINDER (WAJIB)
# ------------------------------------------------------------------------------
# Nilai di bawah adalah SUMBER AWAL saja. Setelah dashboard berjalan,
# kredensial efektif dibaca dari brankas terenkripsi data/zm_credentials.enc
# yang diisi lewat halaman Pengaturan (https://<host>:9443/settings).
#
# Artinya: mengganti password ZoneMinder sehari-hari TIDAK LAGI perlu
# mengedit file ini atau mengubah kode - cukup dari halaman Pengaturan,
# lalu klik Test Connection dan Simpan. Dua variabel ini tetap wajib ada
# karena dipakai sebagai nilai awal saat brankas belum dibuat, dan oleh
# service cctv_checker (container terpisah tanpa akses brankas dashboard).
#
# Ganti default setelah instalasi pertama:
#   ZoneMinder > Options > Users > pilih user > ubah password
# Lalu perbarui nilai di bawah dan jalankan: docker compose up -d
ZM_USER=admin
ZM_PASS=P@ssw0rd

# Alamat ZoneMinder untuk skrip yang jalan dari HOST (scripts/zm_automate.py).
# Dari dalam container nilainya berbeda - lihat ZM_HOST di docker-compose.yml.
ZM_HOST=https://localhost/zm

# ------------------------------------------------------------------------------
# 1b. DATABASE ZONEMINDER (OPSIONAL - hanya untuk scripts/test_db.py)
# ------------------------------------------------------------------------------
# Skrip diagnostik database TIDAK ikut container; dijalankan manual dari host.
# Blok ini sengaja TIDAK dipakai docker-compose, jadi tidak akan membuat
# docker compose up gagal walaupun dibiarkan seperti apa adanya.
#
# Perhatian: user MySQL ZoneMinder (default zmuser) berbeda dari user web
# ZoneMinder. Lihat zm-conf/ atau Options > Database untuk nilainya.
ZM_DB_HOST=localhost
ZM_DB_PORT=3306
ZM_DB_NAME=zm
# ZM_DB_USER=zmuser
# ZM_DB_PASS=ganti_dengan_password_mysql

# ------------------------------------------------------------------------------
# 2. INTERVAL & PERILAKU CCTV HEALTH CHECKER
# ------------------------------------------------------------------------------
# Interval pengecekan RTSP (detik). 600 = 10 menit, cukup untuk pemantauan.
CHECK_INTERVAL=600

# Timeout koneksi TCP ke port RTSP kamera (detik).
RTSP_TIMEOUT=3.0

# Umur simpan log MQTT sebelum dibersihkan otomatis (hari).
RETENTION_DAYS=10

# Status checker saat container pertama dinyalakan: true = langsung aktif.
# false = menunggu tombol Aktifkan Checker di dashboard.
CHECKER_ENABLED=false

# ------------------------------------------------------------------------------
# 3. MQTT (WAJIB - MQTT_USER & MQTT_PASS)
# ------------------------------------------------------------------------------
# Broker menolak koneksi anonim (allow_anonymous false di mosquitto.conf).
# Karena itu MQTT_USER dan MQTT_PASS WAJIB terisi dan harus cocok dengan
# isi file mosquitto_config/passwd. Bila tidak cocok, container
# cctv_checker_service akan terus gagal konek dengan log:
#   [WARN] MQTT_USER/MQTT_PASS kosong ...
#   TIDAK DIIZINKAN - periksa MQTT_USER/MQTT_PASS di .env
#
# PENTING: password broker TIDAK bisa dibaca dari file passwd (isinya hash).
# Nilai contoh di bawah NOMINAL - cari atau setel password yang sebenarnya:
#
# a) Instalasi SUDAH pernah jalan -> lihat nilai yang sedang dipakai:
#      docker inspect cctv_checker_service | grep MQTT_PASS
#
# b) Belum tahu / lupa -> setel ulang lalu samakan di sini:
#      docker compose exec mosquitto mosquitto_passwd -b /mosquitto/config/passwd cctv PASSWORD_BARU
#      docker compose restart mosquitto cctv-checker
#
# Setelah stack menyala, pastikan tidak ada penolakan (hasil harus kosong):
#      docker logs cctv_checker_service | grep -i authorised

MQTT_USER=cctv
MQTT_PASS=ganti_dengan_password_mosquitto

# CATATAN: MQTT_BROKER_HOST/PORT/TOPIC di bawah ini hanya DOKUMENTASI.
# docker-compose.yml menuliskannya sebagai nilai tetap (mosquitto/1883/cctv/#).
# Mengubah baris ini TIDAK berpengaruh - ubah langsung docker-compose.yml.
# MQTT_TCP_PORT / MQTT_WS_PORT di bagian 5 hanya mengubah port di HOST;
# listener di mosquitto.conf tetap 1883/9001 (port dalam harus sama).

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC=cctv/#

# ------------------------------------------------------------------------------
# 4. KEAMANAN DASHBOARD (WAJIB - BACA SEBELUM START PERTAMA)
# ------------------------------------------------------------------------------
# DASH_SECRET_KEY dipakai untuk DUA hal sekaligus:
#   1. menandatangani cookie sesi login
#   2. menurunkan kunci enkripsi brankas data/zm_credentials.enc
#
# Nilai contoh di bawah SENGAJA ditolak scripts/preflight.sh. Buat kunci asli:
#     Linux / WSL / Git Bash : head -c 32 /dev/urandom | base64
#     PowerShell             : [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#     Docker (tanpa Python)  : docker run --rm alpine/openssl rand -base64 32
#
# Hasilnya sekitar 44 karakter. Ganti baris di bawah dengan hasil perintah itu.
#
# PENTING: bila DASH_SECRET_KEY diubah setelah brankas berisi kredensial,
# file data/zm_credentials.enc LAMA tidak bisa dibuka lagi. Hapus file itu
# lalu isi ulang kredensial lewat halaman Pengaturan.
DASH_SECRET_KEY=ganti_dengan_kunci_acak_32_byte_base64

# Empat baris di bawah DIPAKAI sungguhan oleh dashboard (html_dashboard/auth.py
# dan app.py) dan diteruskan docker-compose ke container ui-interface.
#   SESSION_TTL_SECONDS    : umur cookie login sebelum harus login ulang (detik)
#   MAX_LOGIN_ATTEMPTS     : jumlah salah password sebelum akun dikunci sementara
#   LOGIN_LOCKOUT_SECONDS  : lama penguncian setelah batas percobaan terlampaui
#   SESSION_COOKIE_SECURE  : kirim cookie hanya lewat HTTPS
SESSION_TTL_SECONDS=43200
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 5. PORT (ubah bila bentrok dengan layanan lain di host)
# ------------------------------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Port KHUSUS dashboard manajemen. Memisahkan halaman manajemen (yang butuh
# login) dari ZoneMinder yang berada di alamat utama :443.
DASHBOARD_HTTPS_PORT=9443

# Port MQTT
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001

# CATATAN PENTING SOAL PORT YANG DIHAPUS:
# DASHBOARD_PORT (8080) dan ZONEMINDER_PORT (8082) TIDAK LAGI ADA. Keduanya
# dulu mempublikasikan port langsung ke host tanpa HTTPS maupun login, sehingga
# menjadi jalur bypass ke seluruh API dashboard dan ke ZoneMinder. Semua akses
# sekarang hanya lewat Caddy:
#   https://<host>/        -> ZoneMinder (publik)
#   https://<host>:9443/   -> Dashboard manajemen (login wajib)
# Untuk debugging internal container:
#   docker exec camera-dashboard curl -s localhost:8080/healthz
#
# Bila mengubah salah satu port di atas, pastikan port tersebut juga bebas di
# host. Cek dengan: bash scripts/preflight.sh

# ------------------------------------------------------------------------------
# 6. DASHBOARD
# ------------------------------------------------------------------------------
# Jumlah thread waitress. Satu thread per koneksi MJPEG persisten.
# 64 cukup untuk puluhan stream bersamaan + beberapa pengguna web.
WSGI_THREADS=64

