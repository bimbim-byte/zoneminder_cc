{
    debug
}

# ============================================================================
# PORT :443 — PUBLIK
#
# Root domain = ZoneMinder. Semua path lain juga diteruskan ke ZoneMinder,
# supaya aset statis yang diminta dari root (mis. /graphics/*.png dari
# /zm/index.php yang dialias ke root) tetap dapat dimuat.
#
# Dashboard manajemen TIDAK lagi dilayani di sini. Dashboard dipindahkan ke
# blok :9443 di bawah agar tidak dapat diakses lewat URL root yang publik.
# ============================================================================
:{$CADDY_HTTPS_PORT:443} {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # Root domain -> ZoneMinder (redirect eksplisit supaya URL di address bar
    # selalu konsisten ber-prefix /zm/).
    @root path /
    redir @root /zm/ 302

    # go2rtc: bawaan image resmi ZoneMinder 1.38, listen internal di
    # 127.0.0.1:1984 dan diproksikan Apache ke /zm/go2rtc/.
    # Masalahnya: API go2rtc TIDAK punya autentikasi (login ZoneMinder tidak
    # menaunginya) dan HLS-nya "Require all granted". Karena blok ini
    # meneruskan SELURUH path ke ZoneMinder, tanpa pengecualian ini
    # /zm/go2rtc/api/hls/* akan terbuka untuk publik di :443.
    # Stack ini memakai MJPEG (/zm/cgi-bin/nph-zms) untuk wall dashboard,
    # jadi go2rtc tidak diperlukan di permukaan publik.
    # DIPAKSA jadi blok "handle": Caddy mengurutkan direktif "respond" SETELAH
    # "handle" pada versi ini, sehingga "respond @matcher" tidak pernah tercapai
    # (reverse_proxy di handle{} sudah menulis respons lebih dulu — terbukti di
    # caddy adapt + access log). Blok handle dievaluasi sesuai urutan penulisan,
    # jadi blok ini HARUS tetap di atas handle{} yang menangkap semua path.
    handle /zm/go2rtc* {
        respond "Not found" 404
    }
    # (baris respond lama dihapus — sudah digantikan blok handle di atas)


    # Sisanya (termasuk /zm*, /cgi-bin*, /css*, /js*, /graphics*, /ajax*)
    # seluruhnya milik ZoneMinder.
    handle {
        reverse_proxy zoneminder:80
    }
}

# ============================================================================
# PORT :9443 — TERBATAS (Dashboard manajemen)
#
# Semua halaman dashboard (portal, kelola kamera, burst add, dan
# pengaturan kredensial) hanya ada di sini, dilindungi login Flask.
#
# Kenapa port terpisah, bukan path seperti /admin?
#   Halaman dashboard memakai URL relatif tanpa prefix, sehingga menaruhnya
#   di :443 akan memaksa path-prefix yang rawan salah saat memanggil /api/*.
#   Port terpisah membuatnya terisolasi total dari permukaan publik :443.
# ============================================================================
:{$DASHBOARD_HTTPS_PORT:9443} {
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # ZoneMinder tetap dijangkau dari dashboard melalui proxy (API + stream),
    # dengan autentikasi dikelola sepenuhnya oleh backend Flask.
    handle /zm* {
        reverse_proxy zoneminder:80
    }
    handle /cgi-bin* {
        reverse_proxy zoneminder:80
    }

    handle {
        reverse_proxy ui-interface:8080
    }
}
